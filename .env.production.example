# Server-side env for docker-compose.prod.yml (never commit the real file).

POSTGRES_USER=bbpms
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_DB=bbpms

# Must use hostname `postgres` (the Compose service name), not localhost.
DATABASE_URL="postgresql://bbpms:generate-a-strong-password@postgres:5432/bbpms?schema=public"

# HMAC key for session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-value"

COMMITTEE_QUORUM="2"
TZ="Asia/Tehran"
APP_PORT="3000"

# Leave false in production. Demo accounts are for local/dev only.
SEED_DATABASE="false"

# Filled in by scripts/deploy.sh / GitHub Actions on each release.
# APP_IMAGE=ghcr.io/<owner>/<repo>/app:<sha>
# MIGRATE_IMAGE=ghcr.io/<owner>/<repo>/migrate:<sha>
