# PostgreSQL connection string used by Prisma CLI and the pg driver adapter.
DATABASE_URL="postgresql://bbpms:bbpms@localhost:5432/bbpms?schema=public"

# HMAC key for signing session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-in-production-please-use-a-long-random-value"

# Default UI locale: fa (RTL) or en (LTR)
NEXT_PUBLIC_DEFAULT_LOCALE="fa"

# Minimum number of committee approvals required for a PIP or termination.
COMMITTEE_QUORUM="2"

# Cycle boundaries are normalized to the server's local day, so pin the timezone.
TZ="Asia/Tehran"
